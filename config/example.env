# Local filesystem paths only. Do not add tokens, API keys, sample identifiers, or credentials.
export MVA_DATA_ROOT=/path/to/case-workspace
export MVA_PROJECT_ROOT=/path/to/this-repository
export CARBON_DECODER_ROOT=/path/to/Carbon-DeCoder
export REFERENCE_FASTA=/path/to/GRCh38.fa

# September 12–14 additions: immutable single-sample inputs and saved metadata.
# AUDIT_OUTPUT must be a fresh path for EACH invocation; never a recorded run.
export AUDIT_SHARED=/path/to/saved-expanded-ensembl-json
export PILOT_SNAPSHOTS=/path/to/saved-pilot-expanded-json
export VENDOR_VCF=/path/to/vendor.single-sample.vcf.gz
export NORMALIZED_VCF=/path/to/normalized.single-sample.vcf.gz
export CORE_VCF=/path/to/core.single-sample.vcf.gz
export CORE_BAM=/path/to/core.markdup.bam
export DELLY_BCF=/path/to/existing.single-sample.delly.bcf
export MASKED_BINS=/path/to/bins.masked.tsv
export CLINVAR_VCF=/path/to/pinned.clinvar.normalized.vcf.gz
export BUB1B_PROTEIN_FASTA=/path/to/bub1b.proteins.fa
export BUB1B_CDS_FASTA=/path/to/bub1b.cds.fa
export UNIPROT_O60566_JSON=/path/to/saved-O60566.json
# Optional tool overrides, not global installations:
# export AUDIT_PYTHON=/path/to/project/.venv/bin/python
# export SAMTOOLS=/path/to/samtools
# export BCFTOOLS=/path/to/bcftools
# Deliberately unset by default. Set to 1 only for an explicitly reviewed API run.
# export MVA_ALLOW_NETWORK=1

# Optional local helper programs used by opt-in exact-allele annotation.
# Bundled Apache-2.0 clients are the defaults; uncomment only to override.
# export ENSEMBL_VEP_WRAPPER=/path/to/ensembl_api.py
# export GNOMAD_WRAPPER=/path/to/get_variant_frequency.py
# export DBSNP_WRAPPER=/path/to/dbsnp_cli.py
